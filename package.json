{
  "name": "refine-obsidian",
  "version": "1.0.1",
  "description": "Check grammar, spelling, and fluency in Markdown notes offline with a local AI model on macOS.",
  "homepage": "https://refine.sh/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refine-sh/refine-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/refine-sh/refine-obsidian/issues"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:conformance": "node test/conformance/run-all.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "grammar",
    "grammar-checker",
    "spell-checker",
    "writing",
    "writing-assistant",
    "proofreading",
    "markdown",
    "offline-ai",
    "macos"
  ],
  "author": "Runjuu",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.1",
    "jsdom": "30.0.1",
    "obsidian": "1.13.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
